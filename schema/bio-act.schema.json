{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kcgoofee-jpg/tavern-bio-context/schema/bio-act.schema.json",
  "title": "TBC v0.3 actuation request (tbc.actuate action)",
  "type": "object",
  "required": ["output"],
  "additionalProperties": false,
  "properties": {
    "output": { "enum": ["Vibrate", "Rotate", "Oscillate", "Constrict", "Spray", "Temperature", "Led", "Position", "HwPositionWithDuration", "Estim"] },
    "pattern": { "enum": ["pulse", "double", "triple", "long", "heartbeat", "wave"], "default": "pulse" },
    "intensity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
    "durationMs": { "type": "integer", "minimum": 1 },
    "reason": { "type": "string", "maxLength": 64 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kcgoofee-jpg/tavern-bio-context/schema/bio-act.schema.json",
  "title": "TBC v0.3 actuation request (tbc.actuate action; pattern native + mode: v0.4 draft)",
  "type": "object",
  "required": [
    "output"
  ],
  "additionalProperties": false,
  "properties": {
    "output": {
      "enum": [
        "*",
        "Vibrate",
        "Rotate",
        "Oscillate",
        "Constrict",
        "Spray",
        "Temperature",
        "Led",
        "Position",
        "HwPositionWithDuration",
        "Estim"
      ],
      "description": "'*' 表示任意输出（执行器有什么就用什么）"
    },
    "pattern": {
      "enum": [
        "pulse",
        "double",
        "triple",
        "long",
        "heartbeat",
        "wave",
        "native"
      ],
      "default": "pulse",
      "description": "native：设备自带模式直通，必须同时写 mode（v0.4 草案 §8.4）"
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "maxLength": 64
    },
    "mode": {
      "type": [
        "string",
        "integer"
      ],
      "description": "v0.4 草案 §8.4：自带模式的序号（1–99）或名字；只用于 pattern 为 native",
      "pattern": "^(?:[1-9][0-9]?|[^\\s|()<>]{1,8})$",
      "minimum": 1,
      "maximum": 99
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pattern": {
            "const": "native"
          }
        },
        "required": [
          "pattern"
        ]
      },
      "then": {
        "required": [
          "mode"
        ]
      }
    },
    {
      "if": {
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "pattern"
        ],
        "properties": {
          "pattern": {
            "const": "native"
          }
        }
      }
    }
  ]
}

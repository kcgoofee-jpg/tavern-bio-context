{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kcgoofee-jpg/tavern-bio-context/schema/bio-variable.schema.json",
  "title": "TBC chat variable bio",
  "description": "聊天变量 bio（v0.2 §3，v0.3 §3 增量；v0.4 草案的 baselineInfo 只在 v 为 0.4 时检查）。未列出的字段允许存在，读者应忽略。",
  "type": "object",
  "required": [
    "v",
    "source",
    "updatedAt",
    "mode"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "source": {
      "type": "string"
    },
    "updatedAt": {
      "type": "integer"
    },
    "mode": {
      "enum": [
        "author",
        "character"
      ],
      "description": "0.x 期间只写旧值；新名写在 view（v0.3 §1.1）。不得出现实现内部名。"
    },
    "baseline": {
      "type": [
        "number",
        "null"
      ]
    },
    "prior": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/daily"
        }
      ]
    },
    "last": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/turn"
        }
      ]
    },
    "turns": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/turn"
      }
    },
    "lastSignal": {
      "type": [
        "object",
        "null"
      ],
      "description": "含模型思维链原文，会随聊天导出；生产者应该提供关闭开关（v0.3 §4.3）"
    },
    "daily": {
      "type": "object"
    },
    "sensor": {
      "type": [
        "object",
        "null"
      ]
    },
    "sensitive": {
      "type": "object",
      "properties": {
        "body": {
          "type": [
            "object",
            "null"
          ]
        },
        "cycle": {
          "type": [
            "object",
            "null"
          ]
        },
        "journal": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "view": {
      "enum": [
        "backstage",
        "in-story",
        "device-aware"
      ],
      "description": "v0.3 起；读者以 view 为准"
    }
  },
  "$defs": {
    "daily": {
      "type": "object",
      "required": [
        "source",
        "fields"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "object"
        }
      }
    },
    "turn": {
      "type": "object",
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "type": "integer"
        },
        "readSec": {
          "type": [
            "number",
            "null"
          ]
        },
        "readPeak": {
          "type": [
            "number",
            "null"
          ]
        },
        "sendBpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "baseline": {
          "type": [
            "number",
            "null"
          ]
        },
        "readPos": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "baselineInfo": {
      "type": [
        "object",
        "null"
      ],
      "description": "v0.4 草案 §3：基线的来源与年龄",
      "required": [
        "method",
        "ageSec"
      ],
      "properties": {
        "method": {
          "enum": [
            "manual",
            "rest",
            "rolling-low",
            "prior-rhr"
          ]
        },
        "n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ageSec": {
          "type": "integer",
          "minimum": 0
        },
        "noise": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "setAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "device": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 32
        },
        "changedFrom": {
          "type": [
            "string",
            "null"
          ]
        },
        "changedTurnsAgo": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": [
        "object",
        "null"
      ],
      "description": "v0.4 草案 §5.5：每个相位的执行器重叠（act）与干净子统计（clean）；生产者只记录，不下结论",
      "propertyNames": {
        "enum": [
          "gen",
          "read",
          "write"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "act": {
            "type": [
              "object",
              "null"
            ],
            "description": "本相位里生产者发出的动作覆盖的秒数、强度与条数（§5.1）；没有动作时省略或为 null",
            "required": [
              "sec",
              "mean",
              "n"
            ],
            "properties": {
              "sec": {
                "type": "integer",
                "minimum": 1
              },
              "mean": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "发出的强度 × 100 取整（0 就是停止，所以最小为 1）"
              },
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "这些秒里驱动过的输出类型（含有风险的 Temperature / Estim / Spray）"
              }
            },
            "additionalProperties": false
          },
          "clean": {
            "type": [
              "object",
              "null"
            ],
            "description": "只用没有驱动的那些秒算出的统计（§5.2）；不满足最短与占比要求时省略或为 null",
            "required": [
              "sec",
              "phaseSec"
            ],
            "properties": {
              "sec": {
                "type": "integer",
                "minimum": 0
              },
              "phaseSec": {
                "type": "integer",
                "minimum": 0
              },
              "first": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "last": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "peak": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "peakAt": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "相对本相位开始的秒数"
              },
              "cov": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "hrv": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "turnV04": {
      "allOf": [
        {
          "$ref": "#/$defs/turn"
        },
        {
          "type": "object",
          "properties": {
            "phases": {
              "$ref": "#/$defs/phases"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "view"
        ],
        "properties": {
          "view": {
            "const": "backstage"
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "const": "author"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "view"
        ],
        "properties": {
          "view": {
            "enum": [
              "in-story",
              "device-aware"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "const": "character"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "v": {
            "const": "0.4"
          }
        },
        "required": [
          "v"
        ]
      },
      "then": {
        "properties": {
          "baselineInfo": {
            "$ref": "#/$defs/baselineInfo"
          },
          "last": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/turnV04"
              }
            ]
          },
          "turns": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/turnV04"
            }
          }
        }
      }
    }
  ]
}

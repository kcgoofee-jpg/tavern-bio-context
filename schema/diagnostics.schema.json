{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kcgoofee-jpg/tavern-bio-context/schema/diagnostics.schema.json",
  "title": "TBC diagnostics (tbc.diagnostics())",
  "description": "实现自报的运行状态与问题清单（v0.3 §4.2），供卡片与用户界面解释“为什么没联动”。不含心率序列、设备序列号与令牌。",
  "type": "object",
  "required": [
    "implementation",
    "version",
    "spec",
    "at",
    "device",
    "mode",
    "injection",
    "problems"
  ],
  "properties": {
    "implementation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": {
      "type": "string"
    },
    "spec": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "at": {
      "type": "integer",
      "minimum": 0
    },
    "environment": {
      "type": "object",
      "properties": {
        "bluetooth": {
          "type": "boolean"
        },
        "secure_context": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        }
      }
    },
    "device": {
      "type": "object",
      "required": [
        "connected"
      ],
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 32,
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
              "not": {
                "pattern": "\\d{6,}|(?:^|[.-])(?=[0-9a-f]*[0-9])[0-9a-f]{6,}(?:$|[.-])"
              }
            }
          ],
          "description": "设备型号（v0.3 §2.6）：小写字母数字，用 . 或 - 连接，≤ 32 字符；不得含序列号（连续 6 位以上数字，或长度 ≥ 6 且含数字的十六进制段）"
        },
        "transport": {
          "enum": [
            "ble",
            "bridge",
            "push",
            "api",
            "bus",
            null
          ]
        },
        "cadence_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rr": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "last_sample_age_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "battery": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "mode": {
      "type": "object",
      "required": [
        "value",
        "source"
      ],
      "properties": {
        "value": {
          "enum": [
            "backstage",
            "in-story",
            "device-aware"
          ]
        },
        "source": {
          "enum": [
            "user",
            "card",
            "default"
          ]
        }
      }
    },
    "card": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "card-declaration.schema.json"
        }
      ]
    },
    "injection": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "last_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "last_trigger": {
          "type": [
            "string",
            "null"
          ]
        },
        "background_skipped": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "scan_world_info": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "块是否参与世界书扫描（v0.3 §2.7）"
        },
        "invalid_blocks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "自检不通过、改注入最小块的次数（v0.3 §2.5）"
        }
      }
    },
    "interpretation": {
      "type": "object",
      "properties": {
        "guide_active": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "NO_BLUETOOTH",
              "INSECURE_CONTEXT",
              "NO_DEVICE",
              "DEVICE_SILENT",
              "NO_RR",
              "SPARSE_SOURCE",
              "MODE_BACKSTAGE",
              "INJECTION_DISABLED",
              "GUIDE_INACTIVE",
              "MULTI_WINDOW",
              "HOST_UNSUPPORTED",
              "BAD_INPUT",
              "BLOCK_INVALID",
              "GUIDE_CONFLICT",
              "TOY_STOP_FAILED",
              "TOY_MAYBE_RUNNING",
              "TOY_EXCLUSIVE_BUSY",
              "TOY_HANDSHAKE_TIMEOUT",
              "MULTI_PRODUCER",
              "SCAN_COLLISION"
            ]
          },
          "severity": {
            "enum": [
              "error",
              "warn",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "producer": {
      "type": [
        "object",
        "null"
      ],
      "description": "当前生产者身份（v0.3 §4.6），同 tbc.producer()",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "impl": {
          "type": "string"
        },
        "self": {
          "type": "boolean",
          "description": "是不是本实现"
        }
      }
    }
  }
}

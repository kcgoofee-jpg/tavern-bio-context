{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kcgoofee-jpg/tavern-bio-context/schema/actuator.schema.json",
  "title": "TBC v0.3 actuator capabilities (tbc.registerActuator caps)",
  "type": "object",
  "required": ["outputs"],
  "additionalProperties": false,
  "properties": {
    "outputs": { "type": "array", "minItems": 1, "items": { "enum": ["Vibrate", "Rotate", "Oscillate", "Constrict", "Spray", "Temperature", "Led", "Position", "HwPositionWithDuration", "Estim"] } },
    "patterns": { "type": "array", "items": { "enum": ["pulse", "double", "triple", "long", "heartbeat", "wave"] } },
    "levels": { "type": "boolean", "description": "true: 能按强度连续调节（玩具）；false: 只有开关或固定模式（手环）" },
    "maxIntensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "maxDurationMs": { "type": "integer", "minimum": 1 },
    "minIntervalMs": { "type": "integer", "minimum": 0, "default": 10000 },
    "device": { "type": "string", "maxLength": 64, "pattern": "^[^\\n]*$" },
    "via": { "enum": ["page", "bridge", "intiface", "other"] }
  }
}
